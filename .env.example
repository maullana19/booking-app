# ===========================================
# APPLICATION
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# DATABASE (MySQL)
# ===========================================
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_NAME=booking_db

# ===========================================
# JWT
# ===========================================
# Minimum 32 characters. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_long
JWT_EXPIRES_IN=24h

# ===========================================
# IMAGEKIT (Poster Upload)
# ===========================================
# Get from: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# OPTIONAL
# ===========================================
# CORS origin (if frontend is on a different domain)
# CORS_ORIGIN=http://localhost:5173

# Order payment expiry (minutes)
# ORDER_EXPIRY_MINUTES=15